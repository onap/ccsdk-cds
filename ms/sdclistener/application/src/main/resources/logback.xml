<configuration>
    <!-- CDS_LOG_FORMAT selects the console appender by name: text (default) or json -->
    <appender name="text" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{50} - %msg%n</pattern>
        </encoder>
    </appender>
    <appender name="json" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <!-- Jackson modules found on the classpath need not match jackson-databind and fail the encoder -->
            <findAndRegisterJacksonModules>false</findAndRegisterJacksonModules>
        </encoder>
    </appender>

    <root level="info">
        <appender-ref ref="${CDS_LOG_FORMAT:-text}"/>
    </root>

    <logger name="org.springframework" level="info"/>
    <logger name="org.springframework.web" level="info"/>
    <logger name="org.onap.ccsdk.cds" level="info"/>

</configuration>
